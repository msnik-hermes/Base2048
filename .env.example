# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# The SITE KEY is public — Vite embeds it in the client bundle.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# The SECRET KEY is server-side only — used by the Pages Function.
# Set it as a runtime env var in Cloudflare Pages, NOT in the client.
TURNSTILE_SECRET_KEY=0x4AAAAAAA...
