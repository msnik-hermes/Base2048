# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# The SITE KEY is public and committed in src/data/turnstile.ts (Vercel blocks
# VITE_-prefixed env vars). Only set it here if you build elsewhere.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEh9D4oB-LdKRRbd
# The SECRET KEY is server-side only — set it as a runtime env var on Vercel
# (TURNSTILE_SECRET_KEY), NOT in the client.
TURNSTILE_SECRET_KEY=0x4AAAAAAA...
